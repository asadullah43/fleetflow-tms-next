# Dependencies
node_modules/

# Env files
.env
.env.local
.env.*.local

# Backend build output & generated Prisma client
backend/dist/
backend/generated/
backend/src/generated/
**/generated/prisma/

# Database dumps/backups - never commit real data.
# Scoped to dump filenames only, NOT backend/prisma/migrations/**/*.sql -
# those are tracked on purpose and must never be gitignored.
/backup.sql
/*.sql
backup*.sql
*.dump

# Frontend build output & generated proto client
frontend/.next/
frontend/lib/generated/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# Proto codegen output that isn't backend/frontend-specific
proto/**/*.js
proto/**/*.d.ts

# TLS certificates and keys (scripts/dev-cert.sh, or a real one for docker-compose.prod.yml) and the ACME webroot
/certs/
/acme/

# Uploaded files from running the backend locally (UPLOADS_DIR)
backend/uploads/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
