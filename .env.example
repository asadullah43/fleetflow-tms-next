# Copy to `.env` (next to docker-compose.yml) and fill in real values.
# docker compose reads this file automatically.

# Required. Signs login tokens — anyone who knows it can forge any user's
# session, so use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Database password used by the `database` container and the backend.
POSTGRES_PASSWORD=change-me-to-a-strong-password
# POSTGRES_USER=postgres
# POSTGRES_DB=fleetflow

# Optional overrides
# JWT_EXPIRES_IN=1d
# DB_PORT=5433          # host port for Postgres (loopback only)
# HTTP_PORT=8889        # public port for the app (nginx)
