# Copy to `.env` (next to docker-compose.yml) and fill in real values.
# docker compose reads this file automatically. Never commit `.env`.

# Required. Signs login tokens — anyone who knows it can forge any user's
# session, so use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Required. Database password used by the `database` container and the
# backend — docker compose refuses to start without it. Only applied when the
# database volume is first created: for an existing database, put the password
# it already has here (see README "Running with Docker").
POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=fleetflow

# Optional overrides
# SESSION_DURATION=12h      # how long a sign-in lasts before the user must sign in again
# SEED_ADMIN_PASSWORD=      # password for the first admin, used only when the database has no users
# DB_PORT=5433              # host port for Postgres (loopback only)
# HTTP_PORT=8889            # public port for the app (nginx); 80 by default with docker-compose.prod.yml
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8889
#                           # pages on other origins allowed to call the API: exact origins, comma-separated, no wildcards

# Production HTTPS (docker-compose.prod.yml only — see README "Production: HTTPS")
# SERVER_NAME=tms.example.com   # required there; the default CORS origin becomes https://SERVER_NAME
# TLS_CERTS_DIR=/etc/letsencrypt/live/tms.example.com   # required there; holds the certificate and key
# TLS_CERT_FILE=fullchain.pem
# TLS_KEY_FILE=privkey.pem
# HTTPS_PORT=443
# HSTS_MAX_AGE=31536000     # 0 while testing with a self-signed certificate
