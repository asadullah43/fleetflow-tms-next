{
  "name": "fleetflow-backend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "admin": "tsx admin_app.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/integration/*.itest.ts\"",
    "docs:errors": "tsx technical_dev_docs/generate-error-registry.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:dev-data": "tsx prisma/seed-dev-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.1.0",
    "protobufjs": "^7.6.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
