# For running the backend outside Docker (npm run dev). Copy to backend/.env.
# Every variable the backend reads is declared in global_config/index.ts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleetflow?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
GRPC_PORT=50051

# Optional
# SESSION_DURATION=12h
# DEFAULT_COMPANY_ID=1            # company whose name/logo the login screen shows
# RATE_LIMIT_IP_POINTS=1200       # requests per minute per IP
# RATE_LIMIT_USER_POINTS=600      # requests per minute per signed-in user
# RATE_LIMIT_API_KEY_POINTS=300   # requests per minute per API key
# RATE_LIMIT_LOGIN_POINTS=10      # failed sign-ins per username per 15 minutes
# IDEMPOTENCY_TTL_HOURS=24
# DATABASE_POOL_SIZE=10              # connections per API process (see global_config database.pool)
# DATABASE_POOL_TIMEOUT_SECONDS=10
# REDIS_URL=redis://localhost:6379   # read cache; unset = no caching (every read goes to the database)
# CACHE_LIST_TTL_SECONDS=300
# CACHE_DASHBOARD_TTL_SECONDS=120
# CACHE_COMMAND_TIMEOUT_MS=150       # slower than this = treat Redis as down and read the database
# DEBUG_LOGS_ENABLED=false
# SEED_ADMIN_PASSWORD=
# FILES_HTTP_PORT=8081               # file upload / download endpoint (Envoy routes /files/ here)
# UPLOADS_DIR=./uploads              # where uploaded files are stored (a volume in Docker)
# FILE_UPLOAD_MAX_BYTES=10485760     # 10 MB; keep nginx's /grpc/files body limit above it
# FILE_LINK_TTL_SECONDS=300          # how long an open/download link works
# FILE_ORPHAN_TTL_HOURS=24           # uploads never attached to a record are deleted after this
