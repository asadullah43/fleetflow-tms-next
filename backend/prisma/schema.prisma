// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Truck {
  id          Int      @id @default(autoincrement())
  companyId   Int
  truckNumber String
  truckType   String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips                Trip[]
  assignments          TruckDriverAssignment[]
  workOrders           WorkOrder[]
  maintenanceSchedules MaintenanceSchedule[]
  inspections          VehicleInspection[]
  expenses             WorkshopExpense[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, truckNumber])
  @@index([status])
  @@index([companyId])
}

model TruckDriverAssignment {
  id        Int       @id @default(autoincrement())
  companyId Int
  truckId   Int
  driverId  Int
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  truck  Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([truckId, startDate])
  @@index([driverId, startDate])
  @@index([companyId])
}

model Driver {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  nameAr    String?
  phone     String?
  licenseNo String?
  idNumber  String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips       Trip[]
  assignments TruckDriverAssignment[]
  workOrders  WorkOrder[]
  employee    Employee?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, licenseNo])
  @@unique([companyId, idNumber])
  @@index([status])
  @@index([companyId])
}

model Supplier {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String
  nameAr        String?
  contactPerson String?
  phone         String?
  email         String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trips          Trip[]
  payments       SupplierPayment[]
  workOrders     WorkOrder[]
  inventoryItems InventoryItem[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([companyId])
}

model Customer {
  id             Int      @id @default(autoincrement())
  companyId      Int
  name           String
  nameAr         String?
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  vatNumber      String?
  crNumber       String?
  streetName     String?
  buildingNumber String?
  postalCode     String?
  city           String?
  country        String?  @default("SA")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trips         Trip[]
  rateContracts RateContract[]
  invoices      Invoice[]
  loadingOrders LoadingOrder[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([companyId])
}

model Location {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pickupTrips   Trip[] @relation("PickupLocation")
  deliveryTrips Trip[] @relation("DeliveryLocation")

  rateContractsAsPickup   RateContract[] @relation("RateContractPickup")
  rateContractsAsDelivery RateContract[] @relation("RateContractDelivery")

  loadingOrdersAsPickup   LoadingOrder[] @relation("LoadingOrderPickup")
  loadingOrdersAsDelivery LoadingOrder[] @relation("LoadingOrderDelivery")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}

model CargoType {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  status        String   @default("ACTIVE")
  pricingMode   String   @default("PER_MT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trips         Trip[]
  rateContracts RateContract[]
  loadingOrders LoadingOrder[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
}

model Trip {
  id                Int    @id @default(autoincrement())
  companyId         Int
  transactionNumber String

  supplierId Int?
  customerId Int?

  pickupLocationId   Int
  deliveryLocationId Int

  cargoTypeId Int
  quantity    Decimal @db.Decimal(12, 3)

  tripDate DateTime
  truckId  Int
  driverId Int?

  invoiceId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickupLocation   Location  @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  deliveryLocation Location  @relation("DeliveryLocation", fields: [deliveryLocationId], references: [id])
  cargoType        CargoType @relation(fields: [cargoTypeId], references: [id])
  truck            Truck     @relation(fields: [truckId], references: [id])
  driver           Driver?   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, transactionNumber])
  @@index([tripDate])
  @@index([truckId])
  @@index([driverId])
  @@index([customerId])
  @@index([supplierId])
  @@index([cargoTypeId])
  @@index([pickupLocationId])
  @@index([deliveryLocationId])
  @@index([invoiceId])
  @@index([companyId])
}

model RateContract {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  customerId         Int
  pickupLocationId   Int
  deliveryLocationId Int
  cargoTypeId        Int
  rate               Decimal  @db.Decimal(12, 2)
  currency           String   @default("SAR")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pickupLocation   Location  @relation("RateContractPickup", fields: [pickupLocationId], references: [id], onDelete: Restrict)
  deliveryLocation Location  @relation("RateContractDelivery", fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  cargoType        CargoType @relation(fields: [cargoTypeId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, customerId, pickupLocationId, deliveryLocationId, cargoTypeId])
  @@index([companyId])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  companyId     Int
  invoiceNumber String
  customerId    Int
  issueDate     DateTime  @default(now())
  issueTime     DateTime  @default(now())
  dueDate       DateTime
  fromDate      DateTime
  toDate        DateTime
  currency      String    @default("SAR")
  invoiceType   String    @default("STANDARD") // STANDARD | SIMPLIFIED | CREDIT_NOTE | DEBIT_NOTE
  paymentMeans  String    @default("CASH") // CASH | BANK_TRANSFER | CARD | CHEQUE
  vatEnabled    Boolean   @default(false)
  vatPercent    Decimal   @default(0) @db.Decimal(5, 2)
  subtotal      Decimal   @db.Decimal(12, 2)
  vatAmount     Decimal   @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  status        String    @default("UNPAID")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems InvoiceLineItem[]
  trips     Trip[]

  /**
   * -------- ZATCA e-invoicing metadata (Saudi FATURA phase-2) --------
   */
  invoiceUuid         String?              @unique // ZATCA-assigned invoice UUID
  zatcaInvoiceCounter Int? // sequential per-company counter (ZATCA numbering req.)
  invoiceHash         String?              @db.Text // SHA-256 of canonicalized invoice XML
  previousInvoiceHash String?              @db.Text // PIH of immediately preceding invoice (chain)
  cryptographicStamp  String?              @db.Text // base64 ECDSA-P256 signature of invoice hash
  signedC14nXml       String?              @db.Text // canonicalized, signed UBL 2.1 XML (reuse for view / verify)
  qrCode              String?              @db.Text // base64 ZATCA TLV QR payload
  zatcaStatus         String?              @default("PENDING_SIGN") // PENDING_SIGN | SIGNED | REPORTED | CLEARED | REJECTED | FAILED
  zatcaSubmittedAt    DateTime?
  zatcaClearedAt      DateTime?
  createdByCompanyId  Int? // company owning this invoice (multi-tenant isolation)
  zatcaSubmissionLogs ZatcaSubmissionLog[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([zatcaStatus])
  @@index([companyId])
}

model InvoiceLineItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Decimal @db.Decimal(12, 3)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  taxCategory String  @default("S")
  taxPercent  Decimal @default(15) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CompanySettings {
  id               Int      @id @default(autoincrement())
  companyId        Int
  companyName      String
  logoUrl          String?
  vatNumber        String? // 15-digit Saudi VAT number (includes leading '3')
  /**
   * -------- ZATCA Company Information (Phase-2 onboarding) --------
   */
  crNumber         String? // CRN / commercial registration number
  branchName       String? // registered branch name
  industryCategory String? // business industry/category
  city             String? // registered branch city
  country          String   @default("SA") // ISO 3166-1 alpha-2 (SA for Saudi Arabia)
  address          String?
  streetName       String?
  buildingNumber   String?
  postalCode       String?
  bankName         String?
  bankAccount      String?
  phone            String?
  email            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /**
   * =====================================================================
   * ZATCA e-invoicing onboarding vault (Saudi e-invoicing / phase-2)
   * ---------------------------------------------------------------------
   * - SECRETS in this vault are AES-256-GCM encrypted at rest (key from
   * ZATCA_MASTER_KEY env) and are NEVER returned by any API surface.
   * - The ZATCA hash-chain COUNTERS live ONLY here + on Invoice records,
   * both in PostgreSQL — PostgreSQL is the authoritative source of truth.
   * Redis (when wired later) will be a non-authoritative cache ONLY.
   * =====================================================================
   */
  zatcaEnvironment           String    @default("SANDBOX") // SANDBOX | PRODUCTION
  zatcaOnboardStage          String    @default("NOT_STARTED") // NOT_STARTED | CSR_GENERATED | COMPLIANCE_CSID_PENDING | COMPLIANT | PRODUCTION_CSID | READY
  zatcaInvoiceCounter        Int       @default(0) // sequential ZATCA numbering counter
  zatcaLastInvoiceHash       String?   @db.Text // previous invoice hash -> PIH chaining
  /**
   * -------- encrypted secrets vault (protection: 'zatca-vault' permission) --------
   */
  zatcaCsrPemEnc             String?   @db.Text // encrypted CSR PEM
  zatcaCsrPrivateKeyPemEnc   String?   @db.Text // encrypted ECDSA P-256 private key (signer)
  zatcaComplianceCsidCertEnc String?   @db.Text // encrypted compliance CSID cert PEM + private key
  zatcaComplianceSecretEnc   String?   @db.Text // encrypted compliance invoice-signing secret
  zatcaProductionCsidCertEnc String?   @db.Text // encrypted production CSID cert PEM + private key
  zatcaProductionSecretEnc   String?   @db.Text // encrypted production invoice-signing secret
  /**
   * -------- attestation status --------
   */
  zatcaComplianceStatus      String? // COMPLIANT | REJECTED | EXPIRED
  zatcaLastOnboardError      String?   @db.Text
  zatcaLastOnboardedAt       DateTime?
  zatcaLastSubmittedAt       DateTime?
  zatcaLastSubmissionStatus  String?   @db.Text // http status from last invoice submission

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId])
}

model ZatcaSubmissionLog {
  id           Int       @id @default(autoincrement())
  invoiceId    Int
  operation    String // SUBMIT | CLEARANCE_STATUS | CSID_ONBOARD
  status       String    @default("PENDING") // PENDING | SUCCESS | FAILED | RETRY
  attempt      Int       @default(1)
  invoiceHash  String?   @db.Text
  requestBody  String?   @db.Text
  responseBody String?   @db.Text
  httpStatus   Int?
  zatcaStatus  String? // REPORTED | CLEARED | REJECTED | SUBMITTED
  responseUuid String?
  errorCode    String?
  errorMessage String?   @db.Text
  requestAt    DateTime  @default(now())
  responseAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, operation])
  @@index([status])
}

model SupplierPayment {
  id          Int      @id @default(autoincrement())
  companyId   Int
  supplierId  Int
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("SAR")
  paymentDate DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([paymentDate])
  @@index([companyId])
}

model LoadingOrder {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  serialNumber       String
  batchId            Int
  pickupLocationId   Int
  deliveryLocationId Int
  customerId         Int
  cargoTypeId        Int
  createdAt          DateTime @default(now())

  pickupLocation   Location  @relation("LoadingOrderPickup", fields: [pickupLocationId], references: [id], onDelete: Restrict)
  deliveryLocation Location  @relation("LoadingOrderDelivery", fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cargoType        CargoType @relation(fields: [cargoTypeId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, serialNumber])
  @@index([customerId])
  @@index([batchId])
  @@index([companyId])
}

model User {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  email        String   @unique
  username     String?  @unique
  passwordHash String
  role         String   @default("DISPATCHER")
  roleId       Int?
  language     String   @default("en")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleRef Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)

  inspections VehicleInspection[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@index([status])
  @@index([companyId])
}

model Role {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  users       User[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([name])
  @@index([companyId])
}

model Permission {
  id        Int     @id @default(autoincrement())
  roleId    Int
  module    String
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
}

// ============================================================
// WORKSHOP MODULE
// ============================================================

model WorkOrder {
  id             Int       @id @default(autoincrement())
  companyId      Int
  orderNumber    String
  truckId        Int
  driverId       Int?
  supplierId     Int?
  issue          String
  diagnosis      String?
  description    String?
  priority       String    @default("MEDIUM")
  status         String    @default("OPEN")
  startDate      DateTime?
  completionDate DateTime?
  odometer       Decimal?  @db.Decimal(12, 1)
  laborCost      Decimal   @default(0) @db.Decimal(12, 2)
  partsCost      Decimal   @default(0) @db.Decimal(12, 2)
  otherCost      Decimal   @default(0) @db.Decimal(12, 2)
  totalCost      Decimal   @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  truck                 Truck                  @relation(fields: [truckId], references: [id], onDelete: Restrict)
  driver                Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  parts                 WorkOrderPart[]
  inspectionItems       InspectionItem[]
  expenses              WorkshopExpense[]
  inventoryTransactions InventoryTransaction[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, orderNumber])
  @@index([truckId])
  @@index([driverId])
  @@index([supplierId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([companyId])
}

/// An inventory item consumed by a work order, drawn from one warehouse.
/// unitCost is the item's cost when it was used (a snapshot); totalCost
/// = unitCost × quantity, and is added to the work order's partsCost.
model WorkOrderPart {
  id          Int      @id @default(autoincrement())
  companyId   Int
  workOrderId Int
  itemId      Int
  warehouseId Int
  quantity    Int      @default(1)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  totalCost   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict: a work order with inventory lines cannot be deleted until they are removed (which returns the stock).
  workOrder WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([companyId])
}

model MaintenanceSchedule {
  id              Int       @id @default(autoincrement())
  companyId       Int
  truckId         Int
  maintenanceType String
  description     String?
  mileageInterval Decimal?  @db.Decimal(12, 1)
  dayInterval     Int?
  lastService     DateTime?
  nextService     DateTime?
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([truckId])
  @@index([nextService])
  @@index([status])
  @@index([companyId])
}

model VehicleInspection {
  id          Int      @id @default(autoincrement())
  companyId   Int
  truckId     Int
  inspectorId Int
  inspectDate DateTime
  odometer    Decimal? @db.Decimal(12, 1)
  notes       String?
  result      String   @default("PASS")
  attachments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  truck     Truck            @relation(fields: [truckId], references: [id], onDelete: Restrict)
  inspector User             @relation(fields: [inspectorId], references: [id], onDelete: Restrict)
  items     InspectionItem[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([truckId])
  @@index([inspectorId])
  @@index([inspectDate])
  @@index([companyId])
}

model InspectionItem {
  id            Int      @id @default(autoincrement())
  companyId     Int
  inspectionId  Int
  workOrderId   Int?
  checklistItem String
  status        String   @default("PASS")
  defect        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  workOrder  WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([inspectionId])
  @@index([workOrderId])
  @@index([companyId])
}

model WorkshopExpense {
  id          Int      @id @default(autoincrement())
  companyId   Int
  truckId     Int
  workOrderId Int?
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  truck     Truck      @relation(fields: [truckId], references: [id], onDelete: Restrict)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([truckId])
  @@index([workOrderId])
  @@index([expenseDate])
  @@index([category])
  @@index([companyId])
}

// ============================================================
// HR MODULE
// ============================================================

model Department {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  nameAr      String?
  description String?
  managerId   Int?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  designations Designation[]
  employees    Employee[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([companyId])
}

model Designation {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  nameAr       String?
  description  String?
  departmentId Int
  level        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees  Employee[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([status])
  @@index([companyId])
}

model Employee {
  id               Int      @id @default(autoincrement())
  companyId        Int
  employeeNumber   String
  name             String
  nameAr           String?
  email            String?
  phone            String?
  idNumber         String?
  joiningDate      DateTime
  employmentType   String   @default("FULL_TIME")
  employmentStatus String   @default("ACTIVE")
  departmentId     Int
  designationId    Int?
  managerId        Int?
  salary           Decimal? @db.Decimal(12, 2)
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  profilePhoto     String?
  notes            String?
  driverId         Int?     @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  department    Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation   Designation?         @relation(fields: [designationId], references: [id], onDelete: SetNull)
  driver        Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  documents     EmployeeDocument[]
  contracts     EmploymentContract[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeNumber])
  @@unique([companyId, email])
  @@index([departmentId])
  @@index([designationId])
  @@index([employmentStatus])
  @@index([joiningDate])
  @@index([companyId])
}

model Attendance {
  id          Int       @id @default(autoincrement())
  companyId   Int
  employeeId  Int
  attendDate  DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT")
  hoursWorked Decimal?  @db.Decimal(5, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendDate])
  @@index([employeeId])
  @@index([attendDate])
  @@index([status])
  @@index([companyId])
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  companyId  Int
  employeeId Int
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     String   @default("PENDING")
  approverId Int?
  comments   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([companyId])
}

model EmployeeDocument {
  id             Int       @id @default(autoincrement())
  companyId      Int
  employeeId     Int
  documentType   String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  /// The uploaded file's API path (/files/<fileId>), set by the server from fileId. Rows from before uploads may hold a typed URL instead.
  fileUrl        String?
  /// The uploaded scan/PDF. A file belongs to at most one record.
  fileId         Int?      @unique
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  file     StoredFile? @relation("EmployeeDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([documentType])
  @@index([expiryDate])
  @@index([companyId])
}

model EmploymentContract {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  employeeId         Int
  contractNumber     String
  contractType       String    @default("FIXED_TERM")
  startDate          DateTime
  endDate            DateTime?
  salary             Decimal?  @db.Decimal(12, 2)
  currency           String?
  terms              String?
  status             String    @default("ACTIVE")
  /// documentUrl / documentUploadedAt / documentUploadedBy are set by the server from documentFileId (the upload), never by the client.
  documentUrl        String?
  title              String?
  documentUploadedAt DateTime?
  documentUploadedBy String?
  documentFileId     Int?      @unique
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  documentFile StoredFile? @relation("EmploymentContractDocument", fields: [documentFileId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([companyId])
}

// ============================================================
// MULTI-TENANCY, API KEYS, IDEMPOTENCY
// ============================================================

/// A tenant. Every business table carries companyId; the tenant-scoped
/// Prisma client (_core_app_connectivities/prisma.ts) filters and stamps it
/// on every query from the authenticated context, so a request can never
/// read or write another company's rows.
model Company {
  id        Int      @id @default(autoincrement())
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trucks                 Truck[]
  truckDriverAssignments TruckDriverAssignment[]
  drivers                Driver[]
  suppliers              Supplier[]
  customers              Customer[]
  locations              Location[]
  cargoTypes             CargoType[]
  trips                  Trip[]
  rateContracts          RateContract[]
  invoices               Invoice[]
  settings               CompanySettings?
  supplierPayments       SupplierPayment[]
  loadingOrders          LoadingOrder[]
  users                  User[]
  roles                  Role[]
  workOrders             WorkOrder[]
  workOrderParts         WorkOrderPart[]
  maintenanceSchedules   MaintenanceSchedule[]
  vehicleInspections     VehicleInspection[]
  inspectionItems        InspectionItem[]
  workshopExpenses       WorkshopExpense[]
  departments            Department[]
  designations           Designation[]
  employees              Employee[]
  attendances            Attendance[]
  leaveRequests          LeaveRequest[]
  employeeDocuments      EmployeeDocument[]
  employmentContracts    EmploymentContract[]
  storedFiles            StoredFile[]
  apiKeys                ApiKey[]
  warehouses             Warehouse[]
  inventoryItems         InventoryItem[]
  inventoryStocks        InventoryStock[]
  inventoryTransactions  InventoryTransaction[]
  idempotencyRecords     IdempotencyRecord[]
}

/// Machine credential for integrations (same APIs as JWT users). Only a
/// SHA-256 hash of the key is stored; the plaintext is shown once at creation.
model ApiKey {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  keyPrefix   String // first characters, for identifying a key in lists/logs
  keyHash     String    @unique
  /// Least-privilege grant, same shape as a role's matrix: [{ module, canView, canAdd, canEdit, canDelete }]
  scopes      Json
  status      String    @default("ACTIVE") // ACTIVE | REVOKED
  createdById Int?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}

/// An uploaded file (employee document scan, contract PDF). The bytes are
/// on disk under the uploads directory at `storageKey`; this row is the
/// only way to reach them. Uploaded first, then attached to a record by
/// its fileId; one never attached is deleted after a day.
model StoredFile {
  id             Int      @id @default(autoincrement())
  companyId      Int
  /// What it was uploaded for (EMPLOYEE_DOCUMENT | CONTRACT_DOCUMENT): decides who may upload and read it.
  purpose        String
  /// The name the user's file had, for display and downloads only — never used as a path.
  originalName   String
  /// Detected from the file's content, not taken from the browser.
  contentType    String
  size           Int
  sha256         String
  /// Path relative to the uploads directory: <companyId>/<random>.
  storageKey     String   @unique
  uploadedById   Int?
  uploadedByName String
  createdAt      DateTime @default(now())

  employeeDocument   EmployeeDocument?   @relation("EmployeeDocumentFile")
  employmentContract EmploymentContract? @relation("EmploymentContractDocument")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([createdAt])
}

/// One row per (tenant, operation, Idempotency-Key): a retried create
/// returns the stored result instead of creating a duplicate.
model IdempotencyRecord {
  id          Int      @id @default(autoincrement())
  companyId   Int
  operation   String // fully-qualified rpc, e.g. fleetflow.invoices.InvoicesService/Create
  key         String
  requestHash String // SHA-256 of the request, to reject key reuse with a different payload
  status      String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  response    Json? // the DB_DATA payload returned by the first successful attempt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, operation, key])
  @@index([expiresAt])
}

// ── Inventory ─────────────────────────────────────────────────────────────

/// A place stock is kept. Stock is tracked per (item, warehouse).
model Warehouse {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  nameAr    String?
  location  String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock          InventoryStock[]
  transactions   InventoryTransaction[]
  workOrderParts WorkOrderPart[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([status])
  @@index([companyId])
}

/// A stocked item. Quantities live in InventoryStock (one row per
/// warehouse); totalQuantity is their sum, kept in the same transaction
/// as every stock change, so "low stock" is one indexed comparison.
model InventoryItem {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String
  nameAr        String?
  itemNumber    String?
  category      String?
  minimumStock  Int      @default(0)
  unitCost      Decimal  @default(0) @db.Decimal(12, 2)
  totalQuantity Int      @default(0)
  supplierId    Int?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier       Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stock          InventoryStock[]
  transactions   InventoryTransaction[]
  workOrderParts WorkOrderPart[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, itemNumber])
  @@index([supplierId])
  @@index([category])
  @@index([status])
  @@index([companyId])
}

/// How many of one item one warehouse holds. Never negative: every
/// decrease is a conditional update (see takeFromStock).
model InventoryStock {
  id          Int      @id @default(autoincrement())
  companyId   Int
  itemId      Int
  warehouseId Int
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
  @@index([companyId])
}

/// The stock ledger: every IN and OUT, never edited or deleted. OUT rows
/// written by a work order carry its id (cleared if the order is deleted).
/// movementDate is when the stock actually moved (chosen by the user,
/// today by default); createdAt is when the entry was recorded.
model InventoryTransaction {
  id           Int      @id @default(autoincrement())
  companyId    Int
  itemId       Int
  warehouseId  Int
  type         String
  quantity     Int
  unitCost     Decimal  @default(0) @db.Decimal(12, 2)
  remarks      String?
  workOrderId  Int?
  movementDate DateTime @default(now())
  createdAt    DateTime @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([warehouseId])
  @@index([workOrderId])
  @@index([type])
  @@index([movementDate])
  @@index([createdAt])
  @@index([companyId])
}
